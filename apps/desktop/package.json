  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc -b && tsdown",
    "dev": "pnpm run build && electron .",
    "verify:runtime": "tsx ../../scripts/verify-runtime-closure.ts --manifest apps/desktop/package.json",
    "package:win": "pnpm run verify:runtime && pnpm run build && electron-builder --win nsis",
    "package:dir": "pnpm run verify:runtime && pnpm run build && electron-builder --dir"
  },
